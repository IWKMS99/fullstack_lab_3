# Настройки PostgreSQL
POSTGRES_DB=roomflow_db
POSTGRES_USER=myuser
POSTGRES_PASSWORD=fialka

# Порт приложения для разработки
SERVER_PORT=8080

# Секрет для JWT
JWT_SECRET=yoursupersecretkeyforjwtthatisverylongandsecure
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=Lax

# MinIO/S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=roomflow-files
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_PRESIGN_TTL_MINUTES=15

# Optional first administrator; configure both values before first startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
